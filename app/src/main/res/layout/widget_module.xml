<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_module_click" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:background="@drawable/widget_tile"
    android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="8dp"
    android:paddingBottom="8dp" android:layout_marginBottom="5dp">
    <TextView android:id="@+id/widget_module_icon" android:layout_width="27dp"
        android:layout_height="wrap_content" android:text="◷" android:textSize="20sp"
        android:textColor="#DCEEFF"/>
    <LinearLayout android:orientation="vertical" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:id="@+id/widget_module_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Почасовой прогноз"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/widget_module_value" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Прогноз" android:singleLine="true"
            android:ellipsize="end" android:textSize="11sp" android:textColor="#E2F0FA"/>
    </LinearLayout>
    <TextView android:layout_width="18dp" android:layout_height="wrap_content"
        android:text="›" android:textSize="19sp" android:textColor="#CEE3F9"
        android:gravity="right"/>
</LinearLayout>